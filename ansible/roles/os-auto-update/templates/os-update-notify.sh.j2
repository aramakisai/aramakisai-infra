#!/usr/bin/env bash
set -euo pipefail

STATUS_DIR="/var/lib/ops-dashboard"

# debsecan --only-fixed は --suite が必須 (無いと rc=1)
# shellcheck disable=SC1091
SUITE=$(. /etc/os-release && echo "${VERSION_CODENAME:-}")

# ダッシュボード (collector) が読むノード保守状態。Discord 通知の成否に依存させないため通知より前に書く。
write_node_status() {
    local upgradable fixable="null" reboot=false pkgs="" out_tmp
    upgradable=$(apt list --upgradable 2>/dev/null | awk -F/ 'NR>1{print $1}' | sort -u | grep -c . || true)
    if command -v debsecan >/dev/null 2>&1 && out_tmp=$(debsecan --only-fixed --suite "${SUITE}"); then
        fixable=$(echo "${out_tmp}" | awk 'NF{print $2}' | sort -u | grep -c . || true)
    fi
    if [[ -f /var/run/reboot-required ]]; then
        reboot=true
        [[ -f /var/run/reboot-required.pkgs ]] && pkgs=$(sort -u /var/run/reboot-required.pkgs)
    fi
    mkdir -p "${STATUS_DIR}"
    # 同一ディレクトリの一時ファイルから mv することで、読み手に書きかけを見せない
    out_tmp=$(mktemp "${STATUS_DIR}/.node-status.XXXXXX")
    jq -n --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --argjson up "${upgradable}" --argjson fx "${fixable}" \
        --argjson rb "${reboot}" --arg pkgs "${pkgs}" \
        '{generated_at: $ts, upgradable_count: $up, security_fixable_count: $fx, reboot_required: $rb,
          reboot_required_pkgs: ($pkgs | split("\n") | map(select(length > 0)))}' > "${out_tmp}"
    chmod 0644 "${out_tmp}"
    mv "${out_tmp}" "${STATUS_DIR}/node-status.json"
}

write_node_status || echo "Warning: node-status.json の書き出しに失敗" >&2
if [[ "${1:-}" == "--status-only" ]]; then
    exit 0
fi

HOSTNAME=$(hostname)
TIMESTAMP=$(date "+%Y-%m-%d %H:%M:%S")

# 異常時のみ通知する。平常時 (自動更新が機能している) は何も送らない。
ALERTS=""

# 1. 修正版が apt にあるのに未適用 = 自動更新が機能していない。
# apt 側に候補のない fixable は debsecan が他 suite 基準で判定したもので対応不能のため、通知理由にしない。
if command -v debsecan >/dev/null 2>&1; then
    if FIXABLE_OUT=$(debsecan --only-fixed --suite "${SUITE}"); then
        FIXABLE_PKGS=$(echo "${FIXABLE_OUT}" | awk 'NF{print $2}' | sort -u)
        UPGRADABLE_PKGS=$(apt list --upgradable 2>/dev/null | awk -F/ 'NR>1{print $1}' | sort -u)
        AUTO_PENDING=$(comm -12 <(echo "${FIXABLE_PKGS}") <(echo "${UPGRADABLE_PKGS}") | paste -sd, -)
        if [[ -n "${AUTO_PENDING}" ]]; then
            ALERTS+="自動更新対象のはずが未適用: ${AUTO_PENDING} → unattended-upgrades の失敗の可能性、要調査。
"
        fi
    else
        ALERTS+="debsecan の実行に失敗。
"
    fi
else
    ALERTS+="debsecan が未インストール。
"
fi

# 2. 自動再起動は 03:30 起点で毎日走るため、26 時間超 reboot-required が残るなら再起動に失敗している
if [[ -n "$(find /var/run/reboot-required -mmin +1560 2>/dev/null)" ]]; then
    ALERTS+="reboot-required が26時間以上解消されていない → 自動再起動の失敗の可能性、要調査。
"
fi

if [[ -z "${ALERTS}" ]]; then
    exit 0
fi

MESSAGE="[${HOSTNAME}] OS Auto-update Alert - ${TIMESTAMP}

${ALERTS}"

# 3. Source env and send to discord
# shellcheck disable=SC1091
source /etc/os-update-notify.env

if [[ -z "${DISCORD_OPS_WEBHOOK_URL:-}" ]]; then
    echo "Error: DISCORD_OPS_WEBHOOK_URL is empty." >&2
    exit 1
fi

# Truncate message if it exceeds Discord character limit (2000 characters)
MESSAGE_LEN=$(printf '%s' "${MESSAGE}" | wc -c)
if [[ "${MESSAGE_LEN}" -gt 1900 ]]; then
    MESSAGE="${MESSAGE:0:1900}...(truncated)"
fi

PAYLOAD=$(jq -n --arg content "${MESSAGE}" '{content: $content}')

curl -sS -X POST -H "Content-Type: application/json" -d "${PAYLOAD}" "${DISCORD_OPS_WEBHOOK_URL}"
